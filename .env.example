# ----------------------------------------------------------------- servidor
PORT=3000
NODE_ENV=development

# Endereco publico do front, usado para montar o link de redefinicao de senha.
APP_URL=http://localhost:5173

# Origens liberadas no CORS (endereco do front-end). Separe varias por virgula.
CORS_ORIGIN=http://localhost:5173

# Quantos proxies a frente da API sao confiaveis ao resolver o IP do cliente.
# Deixe 0 em desenvolvimento. Atras de Nginx/ELB, use o numero real de saltos:
# com o valor errado o rate limit passa a contar o IP errado.
TRUST_PROXY=0

# ---------------------------------------------------------------------- JWT
# Segredo usado para assinar os tokens. Em producao a aplicacao NAO sobe sem ele.
# Gere um valor forte com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-em-producao

# Tempo de vida do token de sessao (formato do jsonwebtoken: 15m, 2h, 7d...)
JWT_EXPIRES_IN=2h

# Custo do hash bcrypt (10 a 12 e o intervalo recomendado)
BCRYPT_SALT_ROUNDS=10

# Validade do token de recuperacao de senha, em minutos
RESET_TOKEN_TTL_MINUTES=30

# -------------------------------------------------------------------- banco
# sqlite (desenvolvimento) ou postgres (producao).
# Para postgres, instale antes o driver: npm install pg pg-hstore
DB_DIALECT=sqlite

# Arquivo do SQLite (usado apenas com DB_DIALECT=sqlite)
DB_STORAGE=./hygia.sqlite

# Conexao do Postgres (usada apenas com DB_DIALECT=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hygia
DB_USER=postgres
DB_PASSWORD=

# Loga no console o SQL gerado pelo Sequelize
DB_LOGGING=false

# Cria/ajusta as tabelas na subida. Comodo em dev; em producao use migrations.
DB_SYNC=true

# --------------------------------------------------------------- rate limit
# Janela de contagem, em minutos, e o teto por IP em cada grupo de rotas.
RATE_LIMIT_JANELA_MINUTOS=15
RATE_LIMIT_MAX_GERAL=40
RATE_LIMIT_MAX_LOGIN=7
RATE_LIMIT_MAX_RECUPERACAO=5
RATE_LIMIT_MAX_CADASTRO=10

# ------------------------------------------------------------------- e-mail
# Sem SMTP_HOST, o ambiente de desenvolvimento cria sozinho uma conta no
# Ethereal Email e devolve um link para ver a mensagem no navegador.
# Em producao, SMTP_HOST e obrigatorio.
MAIL_FROM="Hygia Software <nao-responda@hygia.local>"
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
