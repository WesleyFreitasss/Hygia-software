# Porta do servidor HTTP
PORT=3000

# Segredo usado para assinar os tokens JWT.
# Em producao a aplicacao NAO sobe sem esta variavel.
# Gere um valor forte com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-em-producao

# Tempo de vida do token de sessao (formato aceito pelo jsonwebtoken: 15m, 2h, 7d...)
JWT_EXPIRES_IN=2h

# Custo do hash bcrypt (10 a 12 e o intervalo recomendado)
BCRYPT_SALT_ROUNDS=10

# Validade do token de recuperacao de senha, em minutos
RESET_TOKEN_TTL_MINUTES=30

NODE_ENV=development
